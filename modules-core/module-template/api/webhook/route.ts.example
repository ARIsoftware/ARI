/**
 * Example Public Webhook Route Handler
 *
 * This is a TEMPLATE file showing how to implement a public (unauthenticated)
 * webhook endpoint with proper security validation.
 *
 * To use this template:
 * 1. Copy this file to your module: modules-custom/your-module/api/webhook/route.ts
 * 2. Add publicRoutes to your module.json (see example below)
 * 3. Set the required environment variable
 * 4. Restart the dev server (or run `pnpm generate-module-registry`) —
 *    routes are discovered automatically, there is no manual registration
 *
 * Example module.json publicRoutes configuration:
 * ```json
 * {
 *   "publicRoutes": [
 *     {
 *       "path": "webhook",
 *       "methods": ["POST"],
 *       "security": {
 *         "type": "webhook_signature",
 *         "secretEnvVar": "MY_WEBHOOK_SECRET",
 *         "rateLimit": 100
 *       },
 *       "description": "Receives webhook events from external service"
 *     }
 *   ]
 * }
 * ```
 *
 * IMPORTANT: the security block above is DECLARED METADATA — it surfaces in
 * /health, /settings?tab=api, and the OpenAPI spec, but the framework does
 * NOT enforce it. Public routes bypass authentication AND the module-enabled
 * check entirely, so THIS HANDLER is the only gate. Implement every declared
 * protection yourself, as shown below.
 *
 * Also note: public route paths are matched by exact string comparison —
 * declare static paths only (no [id] segments).
 */

import crypto from 'crypto'
import { NextRequest, NextResponse } from 'next/server'
import { checkRateLimit, getClientIp } from '@/lib/modules/public-route-security'

/** Max requests per minute per client IP — keep in sync with module.json */
const RATE_LIMIT = 100

/**
 * Define your webhook payload type
 */
interface WebhookPayload {
  type: string
  data: {
    id: string
    [key: string]: any
  }
  created_at: string
}

/**
 * Verify an HMAC-SHA256 signature (GitHub-style `x-hub-signature-256`).
 *
 * Each provider has its own scheme — adapt to what your sender uses:
 * - GitHub: `x-hub-signature-256: sha256=<hmac-sha256 of raw body>`
 * - Stripe: `stripe-signature` (timestamped; see Stripe docs)
 * - Svix / Resend: `svix-id` + `svix-timestamp` + `svix-signature`
 *
 * Always compare with crypto.timingSafeEqual, never `===`.
 */
function verifySignature(rawBody: string, received: string | null, secret: string): boolean {
  if (!received) return false
  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(rawBody).digest('hex')
  const receivedBuf = Buffer.from(received)
  const expectedBuf = Buffer.from(expected)
  return receivedBuf.length === expectedBuf.length && crypto.timingSafeEqual(receivedBuf, expectedBuf)
}

/**
 * POST handler - Receives webhook from external service
 *
 * Implements the security declared in module.json publicRoutes:
 * 1. Rate limiting by client IP
 * 2. Signature verification of the raw body
 */
export async function POST(request: NextRequest) {
  try {
    // 1. Rate limit by client IP (in-memory, per-minute window)
    if (!checkRateLimit(`module-template-webhook:${getClientIp(request)}`, RATE_LIMIT)) {
      return NextResponse.json({ error: 'Rate limit exceeded' }, { status: 429 })
    }

    // 2. Verify the signature against the RAW body (read text before parsing —
    //    re-serialized JSON won't match the sender's signature)
    const secret = process.env.MY_WEBHOOK_SECRET
    if (!secret) {
      console.error('[Webhook] MY_WEBHOOK_SECRET is not configured')
      return NextResponse.json({ error: 'Webhook not configured' }, { status: 503 })
    }
    const rawBody = await request.text()
    if (!verifySignature(rawBody, request.headers.get('x-hub-signature-256'), secret)) {
      return NextResponse.json({ error: 'Invalid signature' }, { status: 401 })
    }

    // 3. Parse and process the webhook payload
    const payload: WebhookPayload = JSON.parse(rawBody)

    // Log the event for debugging (remove in production if too verbose)
    console.log(`[Webhook] Received event: ${payload.type}`)

    // Process the webhook based on event type
    switch (payload.type) {
      case 'item.created':
        // Handle item creation event
        console.log(`[Webhook] Item created: ${payload.data.id}`)
        break

      case 'item.updated':
        // Handle item update event
        console.log(`[Webhook] Item updated: ${payload.data.id}`)
        break

      case 'item.deleted':
        // Handle item deletion event
        console.log(`[Webhook] Item deleted: ${payload.data.id}`)
        break

      default:
        // Log unhandled event types for monitoring
        console.log(`[Webhook] Unhandled event type: ${payload.type}`)
    }

    // Return success - webhook providers expect 2xx response
    return NextResponse.json({ received: true })

  } catch (error: any) {
    // Log error for debugging
    console.error('[Webhook] Processing error:', error)

    // Return 500 - webhook provider may retry. Don't echo error details on a
    // public endpoint.
    return NextResponse.json(
      { error: 'Failed to process webhook' },
      { status: 500 }
    )
  }
}

/**
 * GET handler - Health check endpoint
 *
 * Lets external services and monitoring tools verify the webhook endpoint is
 * responsive without sending actual events. No payload, no signature — but
 * remember to declare GET in the module.json publicRoutes methods array,
 * otherwise GET requests require authentication.
 */
export async function GET() {
  return NextResponse.json({
    status: 'ok',
    endpoint: '/api/modules/module-template/webhook',
    description: 'Example webhook receiver for Module Template module',
  })
}
