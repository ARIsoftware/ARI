{
  "id": "chat",
  "group": "AI",
  "name": "Chat",
  "description": "ChatGPT-style conversational interface using any LLM provider configured in Settings → Integrations (OpenAI, Anthropic, Gemini, OpenRouter).",
  "version": "1.0.0",
  "author": "ARI",
  "icon": "MessageSquare",
  "enabled": false,
  "fullscreen": false,
  "menuPriority": 4,
  "permissions": {
    "database": true,
    "api": true,
    "dashboard": false
  },
  "routes": [
    {
      "path": "/chat",
      "label": "Chat",
      "icon": "MessageSquare",
      "sidebarPosition": "main"
    }
  ],
  "dependencies": {
    "modules": [],
    "coreFeatures": []
  },
  "database": {
    "tables": ["chat_conversations", "chat_messages", "chat_uploads"]
  },
  "npmDependencies": {},
  "storage": {
    "bucket": "chat",
    "maxFileSize": 26214400,
    "allowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "text/plain",
      "text/markdown",
      "text/csv",
      "application/json"
    ]
  },
  "submenu": {
    "component": "./components/sidebar-submenu.tsx"
  }
}
