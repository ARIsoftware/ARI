{
  "name": "my-v0-project",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "generate-module-registry": "node scripts/generate-module-registry.js",
    "generate-openapi": "tsx scripts/generate-openapi.ts",
    "generate-test-report": "node scripts/generate-test-report.mjs",
    "openapi:lint": "redocly lint lib/generated/openapi.json",
    "prebuild": "node scripts/generate-module-registry.js && tsx scripts/generate-openapi.ts && redocly lint lib/generated/openapi.json && node scripts/generate-test-report.mjs",
    "build": "next build",
    "predev": "node scripts/generate-module-registry.js && tsx scripts/generate-openapi.ts && node scripts/generate-test-report.mjs",
    "dev": "next dev",
    "start": "next start",
    "setup": "node scripts/install.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:bump": "vitest run --coverage --update"
  },
